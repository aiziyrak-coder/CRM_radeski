# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
ENVIRONMENT=production

# Host port for the web container (bound to 127.0.0.1 only). Free range on server: 9200–9400.
WEB_PORT=9250

# PostgreSQL password (generate: openssl rand -hex 24)
DB_PASSWORD=change-me

# JWT signing secret (generate: openssl rand -hex 32). Required in production.
JWT_SECRET=

# OpenAI API key (phase 0.5: diagnosis normalization; phase 4: STT + call analysis).
# Empty = AI off; calls are still recorded and analysed once the key is added (docs/07_AI.md)
OPENAI_API_KEY=
# AI_STT_MODEL=gpt-4o-transcribe-diarize
# AI_LLM_MODEL=gpt-5.4-mini
# AI_REASONING_EFFORT=low
# AI_MIN_TALK_SECONDS=15

SITE_API_URL=https://api.radeski.uz

# radeski.uz form webhook: the same secret must be configured on the site (HMAC-SHA256 of the body,
# sent as X-Signature). Generate: openssl rand -hex 32
SITE_WEBHOOK_SECRET=

# Optional fallback: poll the site's admin API every 5 minutes for new form submissions
SITE_ADMIN_USERNAME=
SITE_ADMIN_PASSWORD=

# --- Telephony (phase 3, docs/06_TELEFONIYA.md) -------------------------------------------------
# Shared by the CRM and the pbx container. Generate each: openssl rand -hex 32
PBX_API_SECRET=
PBX_SIP_SECRET=
# Public address of the office router (SIP/RTP are forwarded from it to this server)
PBX_PUBLIC_IP=
PBX_SIP_PORT=5060
PBX_RTP_START=17000
PBX_RTP_END=17039
# Clinic hours for the IVR (Asterisk GotoIfTime syntax) and how long a caller waits in the queue
PBX_OPEN_HOURS=08:00-17:59
PBX_OPEN_DAYS=mon-sat
PBX_QUEUE_WAIT=90
# Softphone extensions (assign them to operators in Users)
PBX_EXTENSIONS=101 102 103 104

# Uztelecom SIP trunk (leave SIP_HOST empty until the credentials arrive)
SIP_HOST=
SIP_PORT=5060
SIP_USERNAME=
SIP_PASSWORD=
# (see below for SMS / Telegram / Instagram)
# The clinic's number shown to patients on outbound calls
SIP_NUMBER=
# What goes before the 9-digit number when dialling out through the trunk (998 or 8 or empty)
SIP_DIAL_PREFIX=998

# --- Channels (phase 5, docs/08_KANALLAR.md) ---------------------------------------------------
PUBLIC_URL=https://crm.radeski.uz
# automatic messages (confirmations, reminders) only between these local hours
MESSAGES_FROM_HOUR=9
MESSAGES_TO_HOUR=20
# SMS: eskiz | playmobile | empty (off). Texts must match the provider-moderated templates.
SMS_PROVIDER=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
PLAYMOBILE_ORIGINATOR=3700
# Telegram bot from @BotFather; the secret is any random string (openssl rand -hex 16)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Instagram (Meta app after review)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_USER_ID=
