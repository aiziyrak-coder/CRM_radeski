# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
ENVIRONMENT=production

# Host port for the web container (bound to 127.0.0.1 only). Free range on server: 9200–9400.
WEB_PORT=9250

# PostgreSQL password (generate: openssl rand -hex 24)
DB_PASSWORD=change-me

# OpenAI API key (phase 0.5: diagnosis normalization; phase 4: STT + call analysis)
OPENAI_API_KEY=

SITE_API_URL=https://api.radeski.uz
